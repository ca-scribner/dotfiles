# eza autocompletions
export FPATH="$HOME/.local/src/completions/zsh:$FPATH"

# Set up fzf key bindings and fuzzy completion
if command -v fzf > /dev/null 2>&1; then
  source <(fzf --zsh)
fi

# Set up atuin
# Keep this below `fzf` setup so atuin owns the ctrl+R binding
. "$HOME/.atuin/bin/env"
