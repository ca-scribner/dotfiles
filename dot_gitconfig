[tag]
	gpgsign = true
[gpg "x509"]
	program = /home/scribs/go/bin/gitsign
[gpg]
	format = x509
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
[gitsign]
	connectorID = https://accounts.google.com
[safe]

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[alias]
	fb = "!f(){ git fetch origin \"+refs/heads/$1:refs/remotes/origin/$1\"; }; f"
	fpr = "!f(){ git fetch origin \"+refs/pull/$1/head:refs/remotes/origin/pr/$1\"; }; f"
	dropref = "!f(){ git update-ref -d \"refs/remotes/origin/$1\"; }; f"
