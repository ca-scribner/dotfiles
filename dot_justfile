set shell := ["bash", "-euo", "pipefail", "-c"]

# Go PATH preamble — needed by every go-tool recipe since each runs in its own shell
go_setup := 'export PATH="$PATH:/usr/local/go/bin:${GOPATH:-$HOME/go}/bin"'

# Show available recipes
default:
    @just --justfile {{justfile()}} --list

# ============================================================================
# Meta recipes
# ============================================================================

# Install everything (non-interactive)
install-all: install-cli install-dev install-desktop install-chainguard install-system
    @echo ""
    @echo "All installations complete."
    @echo ""
    @echo "Manual steps remaining:"
    @echo "  gh auth login -p ssh"
    @echo "  ssh-keygen -t ed25519-sk -C 'ca.scribner+1@gmail.com'"
    @echo "  chainctl auth login"
    @echo "  gnome-extensions enable 'pop-shell@system76.com' (after logout/login)"
    @echo "  Log out and back in for docker group + zsh to take effect"

# Essential command-line tools for any machine
install-cli: install-cli-apt-packages install-zsh install-atuin install-claude install-uv install-nvm install-fzf install-fd install-eza install-lazygit install-delta install-diff-so-fancy install-yq install-git-fuzzy install-rtk

# Development runtimes and tooling
install-dev: install-dev-apt-packages install-go install-docker install-homebrew install-ghcli install-gcloud install-terraform install-k3d install-kubectl install-crane install-cue install-dive install-gitsign install-yam install-cargo

# GUI applications and desktop environment
install-desktop: install-desktop-apt-packages install-snap-packages install-chrome install-kitty install-sublime install-jetbrains-toolbox install-obsidian install-dconf-editor install-gnome-browser-connector install-pop-shell configure-gnome

# Chainguard work-specific tools
install-chainguard: install-chainctl install-cg-tokens install-wolfi-rc install-cosign install-hugo install-grype install-syft

# OS-level configuration
install-system: configure-swap

# ============================================================================
# CLI tools
# ============================================================================

install-cli-apt-packages:
    #!/bin/bash
    set -euo pipefail
    sudo apt-get update
    sudo apt-get install -y \
        curl \
        ca-certificates \
        git-all \
        jq

install-zsh: install-cli-apt-packages
    #!/bin/bash
    set -euo pipefail
    if ! command -v zsh &>/dev/null; then
        sudo apt install -y zsh
    fi
    if [[ "$(getent passwd "$USER" | cut -d: -f7)" != "$(which zsh)" ]]; then
        chsh -s "$(which zsh)"
        echo "Default shell changed to zsh — log out and back in for it to take effect"
    fi

install-atuin:
    #!/bin/bash
    set -euo pipefail
    if command -v atuin &>/dev/null; then echo "atuin already installed"; exit 0; fi
    # https://docs.atuin.sh/guide/installation/
    curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | sh

install-claude:
    #!/bin/bash
    set -euo pipefail
    if command -v claude &>/dev/null; then echo "claude already installed"; exit 0; fi
    curl -fsSL https://claude.ai/install.sh | bash

install-uv:
    #!/bin/bash
    set -euo pipefail
    if command -v uv &>/dev/null; then echo "uv already installed"; exit 0; fi
    # https://docs.astral.sh/uv/getting-started/installation/
    wget -qO- https://astral.sh/uv/install.sh | sh

install-nvm:
    #!/bin/bash
    set -euo pipefail
    if [ -d "$HOME/.nvm" ]; then echo "nvm already installed"; exit 0; fi
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash

install-fzf:
    #!/bin/bash
    set -euo pipefail
    if command -v fzf &>/dev/null; then echo "fzf already installed"; exit 0; fi
    # https://github.com/junegunn/fzf
    get_latest_github_release.sh junegunn/fzf fzf

install-fd: install-cli-apt-packages
    #!/bin/bash
    set -euo pipefail
    mkdir -p "$HOME/.local/bin"
    if command -v fd &>/dev/null || command -v fdfind &>/dev/null; then
        echo "fd already installed"
        # Ensure the symlink exists
        if command -v fdfind &>/dev/null && [ ! -e "$HOME/.local/bin/fd" ]; then
            ln -s "$(which fdfind)" "$HOME/.local/bin/fd"
        fi
        exit 0
    fi
    # https://github.com/sharkdp/fd
    sudo apt-get install -y fd-find
    ln -sf "$(which fdfind)" "$HOME/.local/bin/fd"

install-eza: install-cli-apt-packages
    #!/bin/bash
    set -euo pipefail
    if command -v eza &>/dev/null; then echo "eza already installed"; exit 0; fi
    sudo apt-get update
    sudo apt-get install -y eza
    # Zsh completions — .zshrc sets FPATH="$HOME/.local/src/completions/zsh:$FPATH"
    mkdir -p "$HOME/.local/src"
    if [ ! -d "$HOME/.local/src/eza" ]; then
        git clone https://github.com/eza-community/eza.git "$HOME/.local/src/eza"
    fi
    mkdir -p "$HOME/.local/src/completions"
    ln -sfn "$HOME/.local/src/eza/completions/zsh" "$HOME/.local/src/completions/zsh"

install-lazygit:
    #!/bin/bash
    set -euo pipefail
    if command -v lazygit &>/dev/null; then echo "lazygit already installed"; exit 0; fi
    # https://github.com/jesseduffield/lazygit
    get_latest_github_release.sh jesseduffield/lazygit lazygit

install-delta:
    #!/bin/bash
    set -euo pipefail
    if command -v delta &>/dev/null; then echo "delta already installed"; exit 0; fi
    # https://github.com/dandavison/delta
    TEMP_DEB=$(mktemp --suffix=.deb)
    curl -fsSL https://github.com/dandavison/delta/releases/download/0.18.2/git-delta_0.18.2_amd64.deb -o "$TEMP_DEB"
    sudo dpkg -i "$TEMP_DEB"
    rm "$TEMP_DEB"

install-diff-so-fancy:
    #!/bin/bash
    set -euo pipefail
    if command -v diff-so-fancy &>/dev/null; then echo "diff-so-fancy already installed"; exit 0; fi
    # https://github.com/so-fancy/diff-so-fancy
    mkdir -p "$HOME/.local/bin"
    curl -fsSL https://github.com/so-fancy/diff-so-fancy/releases/download/v1.4.4/diff-so-fancy -o "$HOME/.local/bin/diff-so-fancy"
    chmod +x "$HOME/.local/bin/diff-so-fancy"

install-yq:
    #!/bin/bash
    set -euo pipefail
    if command -v yq &>/dev/null; then echo "yq already installed"; exit 0; fi
    # https://github.com/mikefarah/yq
    mkdir -p "$HOME/.local/bin"
    curl -s https://api.github.com/repos/mikefarah/yq/releases/latest \
      | grep "browser_download_url.*yq_linux_amd64.tar.gz" \
      | cut -d : -f 2,3 \
      | tr -d \" \
      | wget -q -i - -O - \
      | tar xz && mv yq_linux_amd64 "$HOME/.local/bin/yq"

install-git-fuzzy:
    #!/bin/bash
    set -euo pipefail
    mkdir -p "$HOME/.local/bin" "$HOME/.local/src"
    if command -v git-fuzzy &>/dev/null; then echo "git-fuzzy already installed"; exit 0; fi
    # https://github.com/bigH/git-fuzzy
    if [ ! -d "$HOME/.local/src/git-fuzzy" ]; then
        git clone https://github.com/bigH/git-fuzzy.git "$HOME/.local/src/git-fuzzy"
    fi
    ln -sf "$HOME/.local/src/git-fuzzy/bin/git-fuzzy" "$HOME/.local/bin/git-fuzzy"

install-rtk:
    #!/bin/bash
    curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | sh
    # Installs claude hook
    rtk init --global

