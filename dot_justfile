install-pop-shell: install-dev-apt-packages
    #!/bin/bash
    set -euo pipefail
    # https://github.com/pop-os/shell
    INSTALL_DIR="$HOME/.local/src/pop-shell"
    if [ -d "$HOME/.local/share/gnome-shell/extensions/pop-shell@system76.com" ]; then
        echo "pop-shell already installed"
        exit 0
    fi
    if ! command -v npm &>/dev/null; then
        echo "ERROR: npm required for pop-shell — skipping"
        exit 1
    fi
    if ! command -v tsc &>/dev/null; then
        sudo npm install -g typescript
    fi
    mkdir -p "$HOME/.local/src"
    if [ ! -d "$INSTALL_DIR" ]; then
        git clone https://github.com/pop-os/shell.git "$INSTALL_DIR"
    fi
    cd "$INSTALL_DIR"
    git checkout master_noble
    make local-install

    echo ""
    echo "NOTE: Log out and back in, then run:"
    echo "  gnome-extensions enable 'pop-shell@system76.com'"

    # Configure Pop Shell keybindings
    export GSETTINGS_SCHEMA_DIR="$HOME/.local/share/gnome-shell/extensions/pop-shell@system76.com/schemas"
    pop="org.gnome.shell.extensions.pop-shell"
    gs() { gsettings set "$pop" "$@"; }

    gs focus-left  "['<Super>Left']"
    gs focus-right "['<Super>Right']"
    gs focus-up    "['<Super>Up']"
    gs focus-down  "['<Super>Down']"

    gs search            "['']"
    gs activate-launcher "['']"
    gs tile-enter        "['']"
    gs toggle-floating   "['']"
    gs tile-swap-left  "['']"; gs tile-swap-right "['']"
    gs tile-swap-up    "['']"; gs tile-swap-down  "['']"
    gs tile-resize-left  "['']"; gs tile-resize-right "['']"
    gs tile-resize-up    "['']"; gs tile-resize-down  "['']"
    gs show-skip-taskbar "['']"

    gs pop-workspace-left  "['']"; gs pop-workspace-right "['']"
    gs pop-workspace-up    "['']"; gs pop-workspace-down  "['']"
    gs pop-monitor-left    "['<Super><Ctrl>Left']"
    gs pop-monitor-right   "['<Super><Ctrl>Right']"
    gs pop-monitor-up      "['<Super><Ctrl>Up']"
    gs pop-monitor-down    "['<Super><Ctrl>Down']"

configure-gnome:
    #!/usr/bin/env bash
    set -euo pipefail
    cat << DCONF_EOF | dconf load /
    [org/gnome/mutter]
    dynamic-workspaces=false
    workspaces-only-on-primary=false

    [org/gnome/desktop/wm/preferences]
    num-workspaces=9

    [org/gnome/shell/app-switcher]
    current-workspace-only=true
    [org/gnome/shell/extensions/dash-to-dock]
    isolate-workspaces=true
    [org/gnome/shell/extensions/tiling-assistant]
    tiling-popup-all-workspace=false

    DCONF_EOF

    gsettings set org.gnome.desktop.peripherals.keyboard delay 200
    dconf write /org/gnome/shell/keybindings/toggle-quick-settings "@as []"

    wm="org.gnome.desktop.wm.keybindings"
    mutter="org.gnome.mutter.keybindings"

    gsettings set "$wm"    maximize            "['']"
    gsettings set "$wm"    unmaximize          "['']"
    gsettings set "$mutter" toggle-tiled-left   "['']"
    gsettings set "$mutter" toggle-tiled-right  "['']"

    shell_kb="org.gnome.shell.keybindings"
    for i in $(seq 1 9); do
        gsettings set "$shell_kb" "switch-to-application-$i" "['']"
    done

    dock="org.gnome.shell.extensions.dash-to-dock"
    if gsettings list-keys "$dock" &>/dev/null; then
        for i in $(seq 1 9); do
            gsettings set "$dock" "app-hotkey-$i" "['']"
        done
        gsettings set "$dock" app-hotkey-10 "['']"
    fi

    gsettings set "$wm" switch-to-workspace-left  "['<Super>Page_Up']"
    gsettings set "$wm" switch-to-workspace-right "['<Super>Page_Down']"
    gsettings set "$wm" move-to-workspace-left  "['<Super><Shift>Page_Up']"
    gsettings set "$wm" move-to-workspace-right "['<Super><Shift>Page_Down']"

    # There is no -first, so we overload the -1 bindings below
    gsettings set "$wm" switch-to-workspace-last "['<Super>End']"
    gsettings set "$wm" move-to-workspace-last "['<Super><Shift>End']"

    gsettings set "$wm" move-to-monitor-left  "['']"
    gsettings set "$wm" move-to-monitor-right "['']"
    gsettings set "$wm" move-to-monitor-up    "['']"
    gsettings set "$wm" move-to-monitor-down  "['']"

    gsettings set "$wm" switch-to-workspace-1 "['<Super>1', '<Super>Home']"
    for i in $(seq 2 9); do
        gsettings set "$wm" "switch-to-workspace-$i" "['<Super>$i']"
    done
    gsettings set "$wm" switch-to-workspace-10 "['<Super>0']"

    gsettings set "$wm" move-to-workspace-1 "['<Super><Shift>1', '<Super><Shift>Home']"
    for i in $(seq 2 9); do
        gsettings set "$wm" "move-to-workspace-$i" "['<Super><Shift>$i']"
    done
    gsettings set "$wm" move-to-workspace-10 "['<Super><Shift>0']"

    echo "GNOME configuration applied."

# ============================================================================
# Chainguard-specific tools
# ============================================================================

install-chainctl:
    #!/bin/bash
    set -euo pipefail
    if command -v chainctl &>/dev/null; then echo "chainctl already installed"; exit 0; fi
    curl -o /tmp/chainctl "https://dl.enforce.dev/chainctl/latest/chainctl_$(uname -s | tr '[:upper:]' '[:lower:]')_$(uname -m | sed 's/aarch64/arm64/')"
    sudo install -o "$UID" -g "$(id -g)" -m 0755 /tmp/chainctl /usr/local/bin/
    rm /tmp/chainctl
    echo "NOTE: Run 'chainctl auth login' manually to authenticate"

install-cg-tokens: install-ghcli install-chainctl
    #!/bin/bash
    set -euo pipefail
    if command -v cg-tokens &>/dev/null; then echo "cg-tokens already installed"; exit 0; fi
    if ! command -v gh &>/dev/null; then echo "ERROR: gh required for cg-tokens"; exit 1; fi
    if ! command -v chainctl &>/dev/null; then echo "ERROR: chainctl required for cg-tokens"; exit 1; fi
    # https://github.com/chainguard-dev/sandbox-of-power/tree/main/martin.wimpress/cg-tokens
    chainctl config set default.social-login google-oauth2
    TEMPFILE=$(mktemp)
    mkdir -p "$HOME/.local/bin"
    wget \
      --header="Authorization: token $(gh auth token)" \
      -O "$TEMPFILE" \
      https://raw.githubusercontent.com/chainguard-dev/sandbox-of-power/refs/heads/main/martin.wimpress/cg-tokens/cg-tokens.sh
    chmod +x "$TEMPFILE"
    mv "$TEMPFILE" "$HOME/.local/bin/cg-tokens"

install-wolfi-rc:
    #!/bin/bash
    set -euo pipefail
    TARGET_DIR="$HOME/code/wolfi-rc/wolfi-rc"
    if [ -d "$TARGET_DIR/main" ]; then echo "wolfi-rc already cloned"; exit 0; fi
    mkdir -p "$TARGET_DIR"
    git clone git@github.com:chainguard-dev/wolfi-rc.git "$TARGET_DIR/main"

install-cosign:
    #!/bin/bash
    set -euo pipefail
    if command -v cosign &>/dev/null; then echo "cosign already installed"; exit 0; fi
    # https://github.com/sigstore/cosign
    LATEST_VERSION=$(curl -s https://api.github.com/repos/sigstore/cosign/releases/latest | grep tag_name | cut -d : -f2 | tr -d "v\", ")
    TEMP_DEB=$(mktemp --suffix=.deb)
    curl -fsSL -o "$TEMP_DEB" "https://github.com/sigstore/cosign/releases/latest/download/cosign_${LATEST_VERSION}_amd64.deb"
    sudo dpkg -i "$TEMP_DEB"
    rm "$TEMP_DEB"

install-hugo:
    #!/bin/bash
    set -euo pipefail
    if command -v hugo &>/dev/null; then echo "hugo already installed"; exit 0; fi
    # https://gohugo.io/installation/linux/
    mkdir -p "$HOME/.local/bin"
    TEMP_DIR=$(mktemp -d)
    curl -s https://api.github.com/repos/gohugoio/hugo/releases/latest \
      | grep -e "browser_download_url.*hugo_extended_[0-9].*_linux-amd64.tar.gz" \
      | cut -d : -f 2,3 \
      | tr -d \" \
      | wget -q -i - -O - \
      | tar xz -C "$TEMP_DIR" && mv "$TEMP_DIR/hugo" "$HOME/.local/bin/hugo"
    rm -rf "$TEMP_DIR"

install-grype:
    #!/bin/bash
    set -euo pipefail
    if command -v grype &>/dev/null; then echo "grype already installed"; exit 0; fi
    # https://github.com/anchore/grype
    mkdir -p "$HOME/.local/bin"
    curl -sSfL https://get.anchore.io/grype | sh -s -- -b "$HOME/.local/bin"

install-syft:
    #!/bin/bash
    set -euo pipefail
    if command -v syft &>/dev/null; then echo "syft already installed"; exit 0; fi
    # https://github.com/anchore/syft
    curl -sSfL https://get.anchore.io/syft | sudo sh -s -- -b /usr/local/bin

# ============================================================================
# System configuration
# ============================================================================

configure-swap:
    #!/bin/bash
    set -euo pipefail
    if [ -f /swapfile ] && swapon --show | grep -q /swapfile; then
        echo "Swap already configured"
        exit 0
    fi
    sudo swapoff -a 2>/dev/null || true
    sudo dd if=/dev/zero of=/swapfile bs=1G count=32
    sudo chmod 0600 /swapfile
    sudo mkswap /swapfile
    sudo swapon /swapfile
    echo "32GB swap file created and enabled"
